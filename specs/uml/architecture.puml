@startuml architecture
' 智能日报生成器 四层架构图（design.md 第 1 章）
skinparam defaultFontName "Microsoft YaHei"
skinparam componentStyle rectangle

package "主编排入口（orchestrator / pipeline）" {
  component "一键运行：采集 → 生成 → 存储 → 推送" as O
}

package "采集层" {
  component "GitHub 提交采集" as C1
  component "飞书任务采集" as C2
  component "飞书消息采集" as C3
  component "飞书考勤采集（v1.1）" as C4
  component "Mock 数据源" as C5
}

package "生成层" {
  component "协同归属 R1/R2/R3" as G1
  component "个人日报生成" as G2
  component "团队日报编排" as G3
}

package "推送层" {
  component "邮件推送（SMTP）" as P1
  component "飞书机器人推送" as P2
}

package "共享基础层" {
  component "models 数据模型" as B1
  component "config 配置与凭证" as B2
  component "storage SQLite 历史" as B3
}

O -down-> C1
O -down-> C2
O -down-> C3
O -down-> C4
C5 -up-> O
O -down-> G1
G1 -down-> G2
G2 -down-> G3
O -down-> B3
O -down-> P1
O -down-> P2
@enduml
